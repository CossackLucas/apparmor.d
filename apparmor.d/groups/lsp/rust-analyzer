abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/rust-analyzer
profile rust-analyzer @{exec_path} {
  include <abstractions/base>
  include <abstractions/cgroup-limits>

  #signal receive set=term peer=kate,
  signal receive set=term,

  @{exec_path} mr,

  owner @{user_projects_dirs}/{,**} r,

  include if exists <local/rust-analyzer>
}

# vim:syntax=apparmor
