abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/drkonqi-coredump-gui
profile drkonqi-coredump-gui @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/graphics>
  include <abstractions/journal-read>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>
  include <abstractions/ssl_certs>

  # Sending of the reports
  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  @{exec_path} mr,

  @{open_path} rPx -> child-open, # ToDo: needed to open konsole with gdb!
  @{bin}/coredumpctl rPx,
  @{bin}/lsb_release  Px,

  @{bin}/{,*} r,

  /usr/share/drkonqi/mappings r,
  /usr/share/org.kde.syntax-highlighting/syntax-bundled/** r,

  owner @{user_cache_dirs}/drkonqi/** rw,
  owner @{user_cache_dirs}/drkonqi/** rwlk -> @{user_cache_dirs}/drkonqi/**,

  owner @{user_config_dirs}/drkonqirc r,
  owner @{user_config_dirs}/kioslaverc r,

  owner @{user_share_dirs}/drkonqi/ w,

  owner @{user_state_dirs}/drkonqistaterc@{atomic} rwlk -> @{user_state_dirs}/#@{int},

  @{run}/mount/utab r,

  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/task/@{tid}/comm w,

  /dev/tty r,

  include if exists <local/drkonqi-coredump-gui>
}

# vim:syntax=apparmor
