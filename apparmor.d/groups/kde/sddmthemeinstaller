abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/sddmthemeinstaller
profile sddmthemeinstaller @{exec_path} {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/bus/system/org.freedesktop.PolicyKit1>
  include <abstractions/common/kde>

  dbus receive bus=system path=/
       interface=org.kde.kf[56]auth
       member=remoteSignal
       peer=(name=@{busname}, label=unconfined),
  dbus send bus=system path=/
       interface=org.kde.kf[56]auth
       member=performAction
       peer=(name=org.kde.kcontrol.kcmsddm, label=unconfined),

  @{exec_path} mr,

  /home/ r,

  owner @{HOME}/ r,

  owner @{user_config_dirs}/ r,

  owner @{tmp}/*.@{archive_ext} rw,

  @{PROC}/sys/kernel/random/boot_id r,

  /dev/tty r,

  include if exists <local/sddmthemeinstaller>
}

# vim:syntax=apparmor
