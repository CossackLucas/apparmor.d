abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/ksecretd
profile ksecretd @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/common/kde>

  #aa:dbus own bus=session name=org.freedesktop.impl.portal.desktop.kwallet
  #aa:dbus own bus=session name=org.freedesktop.impl.portal.Secret path=/org/freedesktop/portal/desktop
  #aa:dbus own bus=session name=org.freedesktop.secrets
  #aa:dbus own bus=session name=org.kde.ksecretd
  #aa:dbus own bus=session name=org.kde.secretservicecompat

  #aa:dbus talk bus=session name=org.freedesktop.secrets label=kwalletd

  @{exec_path} mr,

  @{bin}/gpg     Cx -> gpg,
  @{bin}/gpgconf Cx -> gpg,
  @{bin}/gpgsm   Cx -> gpg,
  @{bin}/kstart rPx,

  owner @{user_config_dirs}/kwalletrc@{atomic} rwlk,

  owner @{user_share_dirs}/kwalletd/ rw,
  owner @{user_share_dirs}/kwalletd/** rwlk -> @{user_share_dirs}/kwalletd/#@{int},

  owner @{run}/user/@{uid}/kwallet5.socket rw,

        @{PROC}/sys/kernel/random/boot_id r,
  owner @{PROC}/@{pid}/mountinfo r,

  /dev/tty r,

  profile gpg {
    include <abstractions/base>

    @{bin}/gpg{,2} mr,
    @{bin}/gpgconf mr,
    @{bin}/gpgsm   mr,

    owner @{user_gpg_dirs}/ w,
    owner @{user_gpg_dirs}/** rwlk -> @{user_gpg_dirs}/**,

    owner @{run}/user/@{uid}/ r,
    owner @{run}/user/@{uid}/gnupg/ r,
    owner @{run}/user/@{uid}/gnupg/S.keyboxd r,

    include if exists <local/ksecretd>
  }

  include if exists <local/ksecretd>
}

# vim:syntax=apparmor
