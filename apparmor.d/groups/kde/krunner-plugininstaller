abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/krunner-plugininstaller
profile krunner-plugininstaller @{exec_path} {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  ptrace read peer=kded,
  ptrace read peer=plasma-discover,

  @{exec_path} mr,

  @{bin}/xdg-open Px -> child-open-any, # ToDo: limit it?

  /etc/machine-id r,

  /usr/share/desktop-base/kf5-settings/kdeglobals r,

  /var/lib/flatpak/exports/share/icons/*/index.theme r,

  owner @{user_share_dirs}/baloo/index r,
  owner @{user_share_dirs}/krunner-sources/{,**} r,

  /dev/tty r,

  include if exists <local/krunner-plugininstaller>
}

# vim:syntax=apparmor

