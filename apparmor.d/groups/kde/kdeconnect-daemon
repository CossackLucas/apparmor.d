abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kdeconnectd
profile kdeconnect-daemon @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/bluetooth-observe>
  include <abstractions/bus/system/org.freedesktop.login1>
  include <abstractions/bus/system/org.freedesktop.UDisks2>
  include <abstractions/bus/system/org.freedesktop.UPower>
  include <abstractions/common/kde>
  include <abstractions/consoles>
  include <abstractions/disks-read>
  include <abstractions/modem-manager-observe>
  include <abstractions/nameservice-strict>
  include <abstractions/network-manager-observe>
  include <abstractions/ssl_certs>
  include <abstractions/sys/dmi>
  include <abstractions/user-download-strict>
  include <abstractions/user-read-strict>

  network bluetooth stream,
  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink dgram,
  network netlink raw,

  signal send set=kill        peer=kdeconnect-daemon//sshfs,
  signal send set=term        peer=kioworker,
  signal send set=(kill term) peer=krdpserver,

  ptrace read peer=plasmashell,

  # dbus drops label for some reason
  dbus send bus=system path=/
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.bluez}"),

  #dbus receive bus=system path=/org/freedesktop/login1
       #interface=org.freedesktop.DBus.Properties
       #member=PropertiesChanged
       #peer=(name=@{busname}, label=systemd-logind),

  #dbus send bus=system path=/org/freedesktop/login1/session/auto
       #interface=org.freedesktop.DBus.Properties
       #member=Get
       #peer=(name=org.freedesktop.login1, label=systemd-logind),

  @{exec_path} mr,

  @{sh_path}           mrCx -> commands,
  @{bin}/fusermount{,3}  Cx -> fusermount,
  @{bin}/kdeconnect-sms  Px,
  @{bin}/krdpserver     rPx,
  @{bin}/sshfs           Cx -> sshfs,
  @{open_path}           Cx -> remote, # to start KRDC and control the remote desktop

  @{lib}/bluetooth/bluetoothd Px,
  #aa:exec kioworker

  /etc/fstab r,

  owner @{user_cache_dirs}/kdeconnect.daemon/ rw,
  owner @{user_cache_dirs}/kdeconnect.daemon/** rwlk -> @{user_cache_dirs}/kdeconnect.daemon/**,

  owner @{user_config_dirs}/*.notifyrc r, # needed to send notifications to other device
  owner @{user_config_dirs}/kdeconnect/ rw,
  owner @{user_config_dirs}/kdeconnect/** rwlk -> @{user_config_dirs}/kdeconnect/**,
  owner @{user_config_dirs}/kioslaverc r,

  owner @{user_share_dirs}/kpeoplevcard/ w,
  owner @{user_share_dirs}/kpeoplevcard/kdeconnect-@{hex32}/ w,
  owner @{user_share_dirs}/user-places.xbel rw,
  owner @{user_share_dirs}/user-places.xbel.* rwl -> @{user_share_dirs}/#@{int},

  owner @{user_state_dirs}/kdeconnect.daemonstaterc r,

  owner @{tmp}/kdeconnect.daemon-@{rand6}/{,*} w,
  owner @{tmp}/plasma-browser-integration_artwork_@{rand6}.@{image_ext} r,

        @{run}/mount/utab r,
  owner @{run}/user/@{uid}/@{hex32}/ w, # sshfs drives
  owner @{run}/user/@{uid}/#@{int} rw,
  owner @{run}/user/@{uid}/kdeconnect.daemon@{rand6}.@{int}.kioworker.socket rwl -> @{run}/user/@{uid}/#@{int},

        @{sys}/bus/ r,
        @{sys}/bus/usb/devices/ r,
        @{sys}/devices/virtual/input/**/uevent r, # for remote control
        @{sys}/devices/**/uevent r,

  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/task/@{tid}/comm w,

  profile commands {
    include <abstractions/base>

    @{sh_path} r,

    @{bin}/loginctl    Px -> kdeconnect-daemon//systemctl,   # lock/unlock screen command
    @{bin}/systemctl   Px -> kdeconnect-daemon//systemctl,   # suspend

    # closing vaults and setting display brightness
    #aa:exec qdbus

    /dev/tty rw,

    # Silencer Inherit
    deny network bluetooth stream,
    deny network inet dgram,
    deny network inet6 dgram,

    include if exists <local/kdeconnect-daemon_commands>
  }

  profile fusermount {
    include <abstractions/base>
    include <abstractions/app/fusermount>

    capability setuid,

    network bluetooth stream,
    network inet dgram,
    network inet6 dgram,

    mount fstype=fuse.sshfs options=(rw nodev nosuid) kdeconnect@192.168.*.*:/ -> @{run}/user/@{uid}/@{hex32}/,

    umount @{run}/user/@{uid}/@{hex32}/,

    / r,

    owner @{run}/user/@{uid}/@{hex32}/ r,

    # Inherit Silencer
    deny /dev/ptmx rw,

    include if exists <local/kdeconnect-daemon_fusermount>
  }

  profile remote {
    include <abstractions/base>
    include <abstractions/app/open>

    @{bin}/xdg-open r,

    owner @{user_cache_dirs}/ksycoca{5,6}_??_* r,
    owner @{user_config_dirs}/kcminputrc r,
    owner @{user_config_dirs}/kdedefaults/kcminputrc r,

    # Silencer Inherit
    deny network bluetooth stream,
    deny network inet dgram,
    deny network inet6 dgram,

    include if exists <local/kdeconnect-daemon_remote>
  }

  profile sshfs {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/nameservice-strict>

    network bluetooth stream,
    network inet dgram,
    network inet6 dgram,
    network inet stream,
    network inet6 stream,

    mount fstype=fuse.sshfs options=(rw nodev nosuid) kdeconnect@192.168.*.*:/ -> @{run}/user/@{uid}/@{hex32}/,

    signal receive set=kill peer=kdeconnect-daemon,

    @{bin}/sshfs r,

    @{bin}/ssh           rix,
    @{bin}/fusermount{,3} Px -> kdeconnect-daemon//fusermount,

    owner @{user_config_dirs}/kdeconnect/privateKey.pem r,

    owner @{run}/user/@{uid}/@{hex32}/ r,

    @{sys}/devices/system/node/ r,

    /dev/fuse rw,
    /dev/ptmx rw,

    include if exists <local/kdeconnect-daemon_sshfs>
  }

  profile systemctl {
    include <abstractions/base>
    include <abstractions/app/systemctl>

    @{bin}/loginctl    r,

    # Silencer Inherit
    deny network bluetooth stream,
    deny network inet dgram,
    deny network inet6 dgram,

    include if exists <local/kdeconnect-daemon_systemctl>
  }

  include if exists <local/kdeconnect-daemon>
}

# vim:syntax=apparmor
