abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/sweeper
profile sweeper @{exec_path} {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/kde-strict>

  @{exec_path} mr,

  owner @{user_config_dirs}/kprivacyrc@{atomic} rwlk -> @{user_config_dirs}/#@{int},

  @{PROC}/sys/kernel/random/boot_id r,

  /dev/tty r,

  include if exists <local/sweeper>
}

# vim:syntax=apparmor
