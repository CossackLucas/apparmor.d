abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kcolorschemeeditor
profile kcolorschemeeditor @{exec_path} {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  ptrace read peer=systemsettings,

  @{exec_path} mr,

  @{bin}/systemsettings r,

  /usr/share/color-schemes/{,*} r,

  owner @{user_share_dirs}/color-schemes/#@{int} rwk,
  owner @{user_share_dirs}/color-schemes/*.colors@{atomic} rwlk -> @{user_share_dirs}/color-schemes/#@{int},

  @{PROC}/sys/kernel/random/boot_id r,

  include if exists <local/kcolorschemeeditor>
}

# vim:syntax=apparmor
