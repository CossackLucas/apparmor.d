abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kdesu
profile kdesu @{exec_path} {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  signal send set=kill peer=su,

  ptrace read   peer=systemsettings,

  @{exec_path} mr,

  @{sh_path}   rix,
  @{bin}/su    rPx -> su,
  @{bin}/xauth rPx,

  @{lib}/kf6/kdesud rix,

  @{bin}/systemsettings r,

        /dev/ptmx rw,
        /dev/tty r,
  owner /dev/pts/@{u8} rw,

  include if exists <local/kdesu>
}

# vim:syntax=apparmor
