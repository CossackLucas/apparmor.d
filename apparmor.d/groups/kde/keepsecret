abi <abi/5.0>,

include <tunables/global>

@{export_ext} = keepsecret

@{exec_path} = @{bin}/keepsecret
profile keepsecret @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/common/kde>
  include <abstractions/disks-read>
  include <abstractions/kde-export-settings>
  include <abstractions/recently-used>

  network netlink raw,

  signal send set=term peer=kioworker,

  @{exec_path} mr,

  #aa:exec kioworker

  /usr/share/thumbnailers/{,*} r,

  /etc/fstab r,

  / r,
  @{bin}/ r,

  owner @{user_cache_dirs}/KDE/keepsecret/ rw,
  owner @{user_cache_dirs}/KDE/keepsecret/** rwlk -> @{user_cache_dirs}/KDE/keepsecret/**,

  owner @{user_share_dirs}/user-places.xbel r,

  owner @{run}/user/@{uid}/#@{int} rw,
  owner @{run}/user/@{uid}/keepsecret@{rand6}.@{int}.kioworker.socket rwl -> @{run}/user/@{uid}/#@{int},

        @{PROC}/sys/kernel/random/boot_id r,
  owner @{PROC}/@{pid}/mountinfo r,

  /dev/tty r,

  include if exists <local/keepsecret>
}

# vim:syntax=apparmor
