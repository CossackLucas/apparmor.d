abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/kwin-applywindowdecoration
profile kwin-applywindowdecoration @{exec_path} {
  include <abstractions/base>
  include <abstractions/kde-strict>

  @{exec_path} mr,

  /etc/machine-id r,

  /usr/share/kwin/decorations/{,**} r,

  owner @{user_config_dirs}/ r,
  owner @{user_config_dirs}/kwinrc* rw,
  owner link @{user_config_dirs}/kwinrc{,.@{rand6}} -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/kwinrc.lock k,

  owner @{user_share_dirs}/aurorae/themes/{,**} r,

  @{PROC}/sys/kernel/random/boot_id r,

  /dev/tty r,

  include if exists <local/kwin-applywindowdecoration>
}

# vim:syntax=apparmor
