abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kde_wacom_tabletfinder
profile kde_wacom_tabletfinder @{exec_path} {
  include <abstractions/base>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  @{bin}/xsetwacom rix,

  include if exists <local/kde_wacom_tabletfinder>
}

# vim:syntax=apparmor
