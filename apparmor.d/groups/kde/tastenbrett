abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/tastenbrett
profile tastenbrett @{exec_path} {
  include <abstractions/base>
  include <abstractions/common/kde>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  owner @{PROC}/@{pid}/task/@{tid}/comm w,

  /dev/tty r,

  include if exists <local/tastenbrett>
}

# vim:syntax=apparmor
