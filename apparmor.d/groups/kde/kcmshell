abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kcmshell6
profile kcmshell @{exec_path} {
  include <abstractions/base>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  /usr/share/hunspell/ r,
  /usr/share/myspell/ r,
  /var/lib/flatpak/runtime/org.kde.Platform.Locale/ r,
  /var/lib/flatpak/runtime/org.kde.Platform.Locale/@{arch}/{,**} r,

  owner @{user_config_dirs}/KDE/#@{int} rwk,
  owner @{user_config_dirs}/KDE/Sonnet.conf@{atomic} rwlk -> @{user_config_dirs}/KDE/#@{int},

  owner @{user_share_dirs}/baloo/index r,

  @{PROC}/sys/kernel/random/boot_id r,

  include if exists <local/kcmshell>
}

# vim:syntax=apparmor
