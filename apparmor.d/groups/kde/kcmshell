abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kcmshell6
profile kcmshell @{exec_path} {
  include <abstractions/base>
  include <abstractions/graphics>
  include <abstractions/kde-sonnet>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  /etc/xdg/kwinrulesrc r,

  @{bin}/ r,

  owner @{user_config_dirs}/kwinrulesrc r,

  owner @{user_share_dirs}/baloo/index r,

  /dev/tty r,

  include if exists <local/kcmshell>
}

# vim:syntax=apparmor
