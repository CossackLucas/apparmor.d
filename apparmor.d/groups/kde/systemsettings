abi <abi/5.0>,

include <tunables/global>

# ToDo: give user access to install custom ICC profiles for displays

@{export_ext} = kksrc shortcuts

@{exec_path} = @{bin}/systemsettings
profile systemsettings @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/bus-session>
  include <abstractions/bus/system/org.freedesktop.PolicyKit1>
  include <abstractions/bus/system/org.freedesktop.systemd1>
  include <abstractions/common/kde>
  include <abstractions/cups-client>
  include <abstractions/dconf-write>
  include <abstractions/disks-read>
  # include <abstractions/file-dialog>
  include <abstractions/ibus-strict>
  include <abstractions/kde-export-settings>
  include <abstractions/nameservice-strict>
  include <abstractions/sys/input>
  include <abstractions/thumbnails-cache-write>
  include <abstractions/user-read-strict>
  # ToDo: backups probably require this, or even more
  # include <abstractions/user-read>

  network netlink raw,

  signal send set=term peer=kioworker,

  #aa:dbus own bus=session name=org.kde.internal.KSettingsWidget_kcm_networkmanagement
  #aa:dbus own bus=session name=org.kde.systemsettings

  @{exec_path} mrix,

  @{open_path} rPx -> child-open-help,
  @{sh_path}   rix,

  @{bin}/aha                               rix,
  @{bin}/baloo_filemetadata_temp_extractor rix,
  @{bin}/basename                          rix,
  @{bin}/cat                               rix,
  @{bin}/clinfo                            rix,
  @{bin}/di-edid-decode                    rix,
  @{bin}/eglinfo{,.@{multiarch}}           rix,
  @{bin}/fwupdmgr                          rPx,
  @{bin}/glxinfo{,.@{multiarch}}           rix,
  @{bin}/gsettings                         rPx,
  @{bin}/kaccess                           rPx,
  @{bin}/kcminit                           rPx,
  @{bin}/kde_wacom_tabletfinder            rPx, # ToDo: not able to test it!
  @{bin}/khelpcenter                       rPx,
  @{bin}/kup-daemon                        rPUx,
  @{bin}/kup-filedigger                    rPUx,
  @{bin}/lsblk                             rPx,
  @{bin}/lspci                             rPx,
  @{bin}/lscpu                             rPx,
  @{bin}/net                               rUx,
  @{bin}/openssl                           rix,
  @{bin}/orca                              rPUx,
  @{bin}/pactl                             rPx,
  @{bin}/par2                              rix, # required by bup
  @{bin}/plasma-apply-lookandfeel          PUx,
  @{bin}/plasma-discover                   rPUx,
  @{bin}/plasmashell                       rPx,
  @{bin}/rsync                             rix,
  @{bin}/sed                               rix,
  @{bin}/sensors                           rPx,
  @{bin}/systemctl                         rCx -> systemctl,
  @{bin}/testparm                          rUx,
  @{bin}/vulkaninfo                        rix,
  @{bin}/wayland-info                      rix,
  @{bin}/xdpyinfo                          rPx,
  @{bin}/xrdb                              rPx,

  # ToDo: ip in @{bin} on Debian!
  @{sbin}/ip                               rix,

  @{lib}/bup/cmd/bup                        rix,
  @{lib}/kf6/kdesu                          rPx -> kdesu,
  @{lib}/qt{5,6}/bin/qdbus                  rPx,
  @{lib}/{,@{multiarch}/libexec/}kinfocenter-{opengl,vulkan}-helper rix,

  #aa:exec kioworker

  /usr/share/hunspell/ r,
  /usr/share/i18n/locales/{,*} r,
  /usr/share/iproute2/group r,
  /usr/share/iso-codes/json/*.json r,
  /usr/share/kcm_networkmanagement/{,**} r,
  /usr/share/kcm_recentFiles/{,**} r,
  /usr/share/kcmkeys/{,*.kksrc} r,
  /usr/share/kgamma/pics/{,*} r,
  /usr/share/kglobalaccel/* r,
  /usr/share/kinfocenter/{,**} r,
  /usr/share/kpackage/{,**} r,
  /usr/share/krunner/dbusplugins/{,*} r,
  /usr/share/kservices{5,6}/{,**} r,
  /usr/share/kservicetypes5/{,**} r,
  /usr/share/kwin/{,**} r,
  /usr/share/kwin-wayland/{,**} r,
  /usr/share/kwin-x11/{,**} r,
  /usr/share/libwacom/{,**} r,
  /usr/share/misc/usb.ids r,
  /usr/share/myspell/ r,
  /usr/share/plasma/{,**} r,
  /usr/share/sddm/themes/{,**} r,
  /usr/share/solid/{,**} r,
  /usr/share/thumbnailers/{,**} r,
  /usr/share/wacomtablet/images/{,*} r,
  /usr/share/wallpapers/{,**} r,

  @{etc_ro}/login.defs r,
  /etc/exports r,
  /etc/fstab r,
  /etc/ImageMagick-@{int}/{,*.xml} r,
  /etc/OpenCL/vendors/{,*} r,
  /etc/plasmalogin.conf r,
  /etc/sddm.conf r,
  /etc/sddm.conf.d/{,**} r,
  /etc/sysconfig/displaymanager r,
  /etc/xdg/* r,
  /etc/xdg/plasmanotifyrc r,
  /etc/xdg/ui/ui_standards.rc r,

  / r,
  @{bin}/ r,
  @{sbin}/ r,

  /var/cache/cracklib/cracklib_dict.* r,
  /var/cache/samba/ rw,
  /var/lib/AccountsService/icons/* r,
  /var/lib/flatpak/repo/{,**} r,

  owner @{HOME}/.face r,
  owner @{HOME}/@{XDG_WALLPAPERS_DIR}/{,**} r,
  # ToDo: check backup on external device!
  owner @{HOME}/.bup*/ rw,

  owner @{user_cache_dirs}/[kK]* rwlk, #-> @{user_cache_dirs}/#@{int},
  owner @{user_cache_dirs}/[kK]*/ rw,
  owner @{user_cache_dirs}/[kK]*/** rwlk, #-> @{user_cache_dirs}/[kK]*/**,
  owner @{user_cache_dirs}/plasma*/{,**} r,
  owner @{user_cache_dirs}/plasma* rw,

  owner @{user_config_dirs}/[kK]* rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/[kK]*/ rw,
  owner @{user_config_dirs}/[kK]*/** rwlk, #-> @{user_config_dirs}/[kK]*/**,
  owner @{user_config_dirs}/{P,p}lasma* r,
  owner @{user_config_dirs}/*rc r,
  owner @{user_config_dirs}/autostart/ rw,
  owner @{user_config_dirs}/autostart/* rwlk, #-> @{user_config_dirs}/autostart/#@{int},
  owner @{user_config_dirs}/baloofileinformationrc@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/device_automounter_kcmrc.lock rwk,
  owner @{user_config_dirs}/discoverrc@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/emaildefaults r,
  owner @{user_config_dirs}/fontconfig/ w,
  owner @{user_config_dirs}/libaccounts-glib/ rw,
  owner @{user_config_dirs}/libaccounts-glib/accounts.db{,-shm,-wal,-journal} rwk,
  owner @{user_config_dirs}/plasma*/{,**} r,
  owner @{user_config_dirs}/plasma-workspace/{,*/} w,
  owner @{user_config_dirs}/plasmakeyboardrc@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/plasmaparc@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/plasmarc@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/PlasmaDiscoverUpdates@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/powerdevilrc.lock rwk,
  owner @{user_config_dirs}/powerdevilrc{,.@{rand6}} rwl, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/qtvirtualkeyboard/ w,
  owner @{user_config_dirs}/session/ rw,
  owner @{user_config_dirs}/session/** rwlk,
  owner @{user_config_dirs}/user-dirs.dirs@{atomic} rwlk, #-> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/wireplumber/ w,
  owner @{user_config_dirs}/wireplumber/wireplumber.conf.d/ w,
  owner @{user_config_dirs}/wireplumber/wireplumber.conf.d/*.conf rw,

  owner @{user_share_dirs}/[kK]* rwlk, #-> @{user_share_dirs}/#@{int},
  owner @{user_share_dirs}/[kK]*/ rw,
  owner @{user_share_dirs}/[kK]*/** rwlk, #-> @{user_share_dirs}/[kK]*/**,
  owner @{user_share_dirs}/baloo/index r,
  owner @{user_share_dirs}/user-places.xbel r,
  owner @{user_share_dirs}/wallpapers/{,**} r,

  owner @{user_state_dirs}/kinfocenterstaterc@{atomic} rwlk, # -> @{user_state_dirs}/#@{int},
  owner @{user_state_dirs}/kiostaterc r,

  owner @{tmp}/dep-@{hex6}.d rw,

        @{run}/ r,
        @{run}/motd.d/{,*} r,
        @{run}/mount/utab r,
  owner @{run}/user/@{uid}/#@{int} rw,
  owner @{run}/user/@{uid}/systemsettings@{rand6}.@{int}.kioworker.socket rw,
  owner link @{run}/user/@{uid}/systemsettings@{rand6}.@{int}.kioworker.socket -> @{run}/user/@{uid}/#@{int},

  #@{run}/udev/data/+*:* r,                # Identifies all subsystems
  @{run}/udev/data/+dmi:* r,              # for motherboard info
  @{run}/udev/data/+drm:card@{int}-* r,   # For screen outputs
  @{run}/udev/data/+input:input@{int} r,  # for mouse, keyboard, touchpad
  @{run}/udev/data/+pci:* r,              # Identifies all PCI devices (CPU, GPU, Network, Disks, USB, etc.)
  #@{run}/udev/data/c@{int}:@{int} r,      # Identifies all character devices
  @{run}/udev/data/c13:@{int} r,          # for /dev/input/*
  @{run}/udev/data/c@{dynamic}:@{int} r,  # For dynamic assignment range 234 to 254, 384 to 511
  @{run}/udev/data/n@{int} r,             # For network interfaces

  @{sys}/ r,
  @{sys}/bus/ r,
  @{sys}/bus/acpi/devices/ r,
  @{sys}/bus/cpu/devices/ r,
  @{sys}/bus/usb/devices/ r,
  @{sys}/class/ r,
  @{sys}/class/hidraw/ r,
  @{sys}/class/input/ r,
  @{sys}/class/video4linux/ r,
  @{sys}/devices/**/uevent r,
  @{sys}/devices/**/report_descriptor r,
  @{sys}/devices/@{pci}/drm/card@{int}/*/edid r,
  @{sys}/devices/@{pci}/sound/**/properties r,
  @{sys}/firmware/acpi/pm_profile r,
  @{sys}/kernel/ r,

        @{PROC}/ r,
        @{PROC}/fs/ r,
        @{PROC}/interrupts r,
  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,

  /dev/ r,
  /dev/bus/usb/ r,
  /dev/input/ r,
  /dev/input/event@{u8} r,
  /dev/rfkill r,
  /dev/snd/ r,
  /dev/tty r,

  profile systemctl {
    include <abstractions/base>
    include <abstractions/app/systemctl>

    include if exists <local/systemsettings_systemctl>
  }

  include if exists <local/systemsettings>
}

# vim:syntax=apparmor
