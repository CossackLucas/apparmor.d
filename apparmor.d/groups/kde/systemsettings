  deny @{lib}/bup/**__pycache__/ w,

  deny /usr/share/qt6/resources/locales/ w,

  profile systemctl {
    include <abstractions/base>
    include <abstractions/app/systemctl>
    include <abstractions/bus-session>
    include <abstractions/bus/system/org.freedesktop.systemd1>
    include <abstractions/journal-read>
    include <abstractions/nameservice-strict>

    #dbus send bus=system path=/org/freedesktop/systemd1/unit/firewalld_2eservice
       #interface=org.freedesktop.DBus.Properties
       #member=GetAll
       #peer=(name=org.freedesktop.systemd1, label=unconfined),

    # For some reason journal-read was not enough, why?
    @{log}/journal/@{hex32}/user-@{uid}@@{hex32}-@{hex16}-@{hex16}.journal r,

    owner @{run}/user/@{uid}/systemd/private rw,

    @{PROC}/@{pids}/comm r,

    include if exists <local/systemsettings_systemctl>
  }

  profile webengine {
    include <abstractions/base>
    include <abstractions/common/chromium>

    @{lib}/{,@{multiarch}/}qt{5,6}/{,libexec/}QtWebEngineProcess r,

    /usr/share/icu/@{int}.@{int}/*.dat r,
    /usr/share/qt6/resources/* r,
    /usr/share/qt6/translations/qtwebengine_locales/*.pak r,

    @{sys}/devices/system/cpu/present r,

          @{PROC}/ r,
          @{PROC}/sys/fs/inotify/max_user_watches r,
          @{PROC}/sys/kernel/yama/ptrace_scope r,
    owner @{PROC}/@{pid}/cmdline r,
    owner @{PROC}/@{pid}/fd/ r,

    #Silencer
    deny owner /usr/share/qt6/resources/locales/ w,

    include if exists <local/systemsettings_webengine>
  }

  include if exists <local/systemsettings>
}

