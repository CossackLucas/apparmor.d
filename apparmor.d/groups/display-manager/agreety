abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/agreety
profile agreety @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>

  @{exec_path} mr,

  /etc/issue r,

  priority=-1 audit @{bin}/** PUx,
  audit @{lib}/** PUx,

  include if exists <local/agreety>
}

# vim:syntax=apparmor
