abi <abi/5.0>,

include <tunables/global>

# ToDO: !!! just a starting point

@{exec_path} = @{lib}/cups/backend/gutenprint@{int2}+usb
profile cups-backend-gutenprint @{exec_path} {
  include <abstractions/base>
  include <abstractions/devices-usb>

  capability net_admin,
  capability sys_admin, # optional: no audit

  network netlink raw,

  @{exec_path} mr,

  / r,

  @{sys}/devices/@{pci}/uevent r,
  @{sys}/devices/@{pci_bus}/uevent r,

  include if exists <local/cups-backend-gutenprint>
}

# vim:syntax=apparmor
