abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/mkfs.jfs
profile mkfs.jfs @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  capability sys_admin,

  @{exec_path} mr,

  @{PROC}/@{pid}/mounts r,

  include if exists <local/mkfs.jfs>
}

# vim:syntax=apparmor
