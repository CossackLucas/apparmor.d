abi <abi/5.0>,

include <tunables/global>

@{exec_path}  = @{sbin}/btrfs @{sbin}/btrfsck
@{exec_path} += @{bin}/btrfs @{bin}/btrfsck #aa:lint ignore=sbin
profile btrfs @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/disks-write>
  include <abstractions/user-download-strict>

  capability sys_admin,
  capability fowner,
  capability sys_rawio,

  @{exec_path} mr,

  @{etc_ro}/blkid.conf r,
  /etc/blkid.conf.d/{,*} r,

  /var/lib/btrfs/ rw,
  /var/lib/btrfs/scrub.progress.@{uuid} rw,
  /var/lib/btrfs/scrub.status.@{uuid}{,_tmp} rwk,

  / r,
  /.snapshots/ r,
  @{efi}/ r,
  @{efi}/**/ r,
  /home/ r,
  /opt/ r,
  /root/ r,
  /srv/ r,
  /usr/local/ r,
  /var/ r,
  @{log}/ r,
  /var/tmp/ r,
  /var/cache/ r,
  @{MOUNTS}/ r,
  @{MOUNTS}/ext2_saved/ rw,
  @{MOUNTS}/ext2_saved/image rw,
  @{MOUNTS}/*/ r,
  @{MOUNTS}/*/ext2_saved/ rw,
  @{MOUNTS}/*/ext2_saved/image rw,

  # To be able to manage btrfs volumes
  owner @{user_img_dirs}/{,**} rwk,

  # For fsck of the btrfs filesystem directly from gparted
  owner @{tmp}/gparted-*/ rw,

  # For fsck of the btrfs filesystem directly from partitionmanager
  /tmp/partitionmanager-@{rand6}/ r,

  @{run}/blkid/blkid.tab{,-@{rand6}} rw,
  @{run}/blkid/blkid.tab.old rwl -> @{run}/blkid/blkid.tab,
  @{run}/snapper-tools-*/ r,
  @{run}/snapper-tools-@{rand6}/@/.snapshots/@{int}/snapshot r,
  @{run}/BtrfsAssistant/@{uuid}/ r,

  @{sys}/fs/btrfs/@{uuid}/** r,
  @{sys}/fs/btrfs/@{uuid}/devinfo/@{int}/scrub_speed_max w,

        @{PROC}/partitions r,
  owner @{PROC}/@{pid}/mounts r,

  /dev/.blkid.tab rw,
  /dev/.blkid.tab-@{rand6} rw,
  /dev/.blkid.tab.old wl -> /dev/.blkid.tab,
  /dev/btrfs-control rw,
  /dev/pts/@{u16} rw,
  /dev/tty@{u8} rw,

  include if exists <local/btrfs>
}

# vim:syntax=apparmor
