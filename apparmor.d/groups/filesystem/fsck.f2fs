abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/fsck.f2fs
profile fsck.f2fs @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  @{exec_path} mr,

  @{PROC}/@{pid}/mounts r,
  @{PROC}/version r,

  include if exists <local/fsck.f2fs>
}

# vim:syntax=apparmor

