abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/fsck.jfs @{sbin}/jfs_debugfs @{sbin}/jfs_tune @{sbin}/mkfs.jfs
profile jfs-utils @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  capability sys_admin,

  @{exec_path} mr,

  /etc/fstab r, # needed by fsck

  @{PROC}/@{pid}/mounts r,

  include if exists <local/jfs-utils>
}

# vim:syntax=apparmor
