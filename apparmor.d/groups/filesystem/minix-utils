abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/fsck.minix @{sbin}/mkfs.minix
profile minix-utils @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-read>

  @{exec_path} mr,

  @{PROC}/@{pid}/mounts r,
  @{PROC}/swaps r,

  include if exists <local/minix-utils>
}

# vim:syntax=apparmor
