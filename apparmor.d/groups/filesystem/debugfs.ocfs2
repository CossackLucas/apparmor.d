abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/debugfs.ocfs2
profile debugfs.ocfs2 @{exec_path} {
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/debugfs.ocfs2>
}

# vim:syntax=apparmor
