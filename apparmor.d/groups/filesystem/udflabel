abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/udflabel
profile udflabel @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  @{exec_path} mr,

  include if exists <local/udflabel>
}

# vim:syntax=apparmor
