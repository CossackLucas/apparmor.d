abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/debugreiserfs @{sbin}/reiserfsck @{sbin}/reiserfstune @{sbin}/resize_reiserfs
profile reiserfs_utils @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  @{exec_path} mr,

  @{PROC}/@{pid}/mounts r,

  include if exists <local/reiserfs_utils>
}

# vim:syntax=apparmor
