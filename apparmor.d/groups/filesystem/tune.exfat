abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/tune.exfat
profile tune.exfat @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  @{exec_path} mr,

  include if exists <local/tune.exfat>
}

# vim:syntax=apparmor

