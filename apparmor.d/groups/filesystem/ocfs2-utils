abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/debugfs.ocfs2 @{sbin}/fsck.ocfs2 @{sbin}/mkfs.ocfs2 @{sbin}/tunefs.ocfs2
profile ocfs2-utils @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  @{exec_path} mr,

  @{bin}/kmod Cx -> kmod,

  @{sys}/fs/o2cb/interface_revision r,
  @{sys}/fs/ocfs2/cluster_stack rw,
  @{sys}/kernel/config/cluster/ r,

  @{PROC}/@{pid}/mounts r,
  @{PROC}/swaps r,

  profile kmod {
    include <abstractions/base>
    include <abstractions/app/kmod>

    capability sys_module,

    @{sys}/module/compression r,
    @{sys}/module/ocfs2_nodemanager/initstate r,
    @{sys}/module/ocfs2_stackglue/initstate r,

    include if exists <local/ocfs2-utils_kmod>
  }

  include if exists <local/ocfs2-utils>
}

# vim:syntax=apparmor
