abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/mount.nilfs2
profile mount.nilfs2 @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-read>

  capability sys_admin,

  @{exec_path} mr,

  include if exists <local/mount.nilfs2>
}

# vim:syntax=apparmor
