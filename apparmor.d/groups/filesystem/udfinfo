abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/udfinfo
profile udfinfo @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-read>

  @{exec_path} mr,

  include if exists <local/udfinfo>
}

# vim:syntax=apparmor
