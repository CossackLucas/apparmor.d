abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/nilfs-resize @{sbin}/nilfs-tune
profile nilfs_utils @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-read>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  include if exists <local/nilfs_utils>
}

# vim:syntax=apparmor
