abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/fsck.hfsplus
profile fsck.hfsplus @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-write>

  @{exec_path} r,

  @{log}/fsck_hfs.log rw,

  @{PROC}/@{pid}/mounts r,

  include if exists <local/fsck.hfsplus>
}

# vim:syntax=apparmor
