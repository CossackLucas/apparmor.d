abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/firewall-cmd
profile firewall-cmd @{exec_path} {
  include <abstractions/base>
  include <abstractions/python>

  @{exec_path} mr,

  include if exists <local/firewall-cmd>
}

# vim:syntax=apparmor
