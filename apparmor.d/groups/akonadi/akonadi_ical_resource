abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/akonadi_ical_resource
profile akonadi_ical_resource @{exec_path} {
  include <abstractions/base>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  owner @{user_cache_dirs}/akonadi_ical_resource_@{int}/{,*} rwlk,

  owner @{user_config_dirs}/akonadi_ical_resource_@{int}rc@{atomic} rwlk,
  owner @{user_config_dirs}/akonadi/ rw,
  owner @{user_config_dirs}/akonadi/** rwlk -> @{user_config_dirs}/akonadi/**,

  owner @{user_share_dirs}/apps/ w,
  owner @{user_share_dirs}/apps/korganizer/** rwlk -> @{user_share_dirs}/apps/korganizer/#@{int},

  owner @{PROC}/@{pid}/mountinfo r,

  /dev/tty r,

  include if exists <local/akonadi_ical_resource>
}

# vim:syntax=apparmor
