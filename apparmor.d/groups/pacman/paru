abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/paru
profile paru @{exec_path} {
  include <abstractions/base>
  include <abstractions/cgroup-limits>
  include <abstractions/consoles>
  include <abstractions/nameservice-strict>
  include <abstractions/ssl_certs>

  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  signal send set=winch peer=aa-install,
  signal send set=winch peer=aa-install//systemctl,
  signal send set=winch peer=pacman,
  signal send set=winch peer=systemd-tty-ask-password-agent,

  @{exec_path} mr,

  @{sh_path}         rix,
  @{editor_path}     Cx -> editor,
  @{pager_path}      Px -> child-pager,
  @{bin}/bat         rix,
  @{bin}/git         Cx -> git,
  @{bin}/gpg{,2}     Cx -> gpg,
  @{bin}/gpgconf     Cx -> gpg,
  @{bin}/gpgsm       Cx -> gpg,
  @{bin}/makepkg     Px,
  @{bin}/pacman      Px,
  @{bin}/pacman-conf Px,
  @{bin}/sudo        Cx -> sudo,

  /etc/paru.conf r,

  /var/lib/pacman/** r,

  owner @{user_cache_dirs}/paru/clone/{,**} rw,
  owner @{user_cache_dirs}/paru/diff/ w,
  owner @{user_cache_dirs}/paru/diff/*.diff w,
  owner @{user_cache_dirs}/paru/packages.aur rw,

  owner @{user_config_dirs}/paru/paru.conf r,

  owner @{user_state_dirs}/paru/{,**}   rw,

  owner @{tmp}/aur@{rand6}/ rw,
  owner @{tmp}/aur@{rand6}/* rw,

  profile editor {
    include <abstractions/base>
    include <abstractions/app/editor>

    owner @{user_cache_dirs}/paru/clone/*/PKGBUILD rw,

    owner @{tmp}/aur@{rand6}/ r,

    include if exists <local/paru_editor>
  }

  profile git {
    include <abstractions/base>
    include <abstractions/app/git>

    owner @{user_cache_dirs}/paru/clone/** rw,
    owner @{user_cache_dirs}/paru/clone/*/.git/** l,

    include if exists <local/paru_git>
  }

  profile gpg {
    include <abstractions/base>
    include <abstractions/consoles>

    @{bin}/gpg{,2}    r,
    @{bin}/gpgconf   r,
    @{bin}/gpgsm  r,

    /etc/pacman.d/gnupg/gpg.conf r,
    /etc/pacman.d/gnupg/pubring.gpg r,
    /etc/pacman.d/gnupg/trustdb.gpg rw,

    owner @{user_gpg_dirs}/ rw,
    owner @{user_gpg_dirs}/** rwlk -> @{user_gpg_dirs}/**,

    # Inherit Silencer
    deny /etc/pacman.d/gnupg/.*  w,

    include if exists <local/paru_gpg>
  }

  profile sudo flags=(attach_disconnected) {
    include <abstractions/base>
    include <abstractions/app/sudo>
    include <abstractions/nameservice-strict>

    capability sys_ptrace,

    ptrace read,

    @{bin}/pacman Px,

    # Inherit Silencer
    deny network inet dgram,
    deny network inet6 dgram,

    include if exists <local/paru_sudo>
  }

  include if exists <local/paru>
}

# vim:syntax=apparmor
