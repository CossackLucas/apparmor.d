abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/mkarchroot
profile mkarchroot @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>

  capability dac_override,
  capability dac_read_search,
  capability sys_admin,

  # ToDo: test
  mount options=(rw rprivate) -> /, # failed mntpnt match
  mount options=(rw move) -> /var/lib/aurbuild/@{arch}/root/**/,

  umount /var/lib/aurbuild/@{arch}/root/**/,

  signal receive set=winch peer=paru//sudo,

  @{exec_path} mr,

  @{sh_path} r,
  @{coreutils_path} rix,

  @{bin}/arch-nspawn  Px,
  @{sbin}/btrfs      rix,
  @{bin}/flock       rix,
  @{bin}/gettext     rix,
  @{bin}/mount       rix,
  @{bin}/pacman       Cx -> pacman,
  @{bin}/pacman-conf rix,
  @{bin}/pacstrap    rix,
  @{bin}/sudo         Cx -> sudo,
  @{bin}/systemd-machine-id-setup rix,
  @{bin}/tput        rix,
  @{bin}/umount      rix,
  @{bin}/unshare     rix,

  /etc/pacman.conf r,
  /etc/pacman.d/{,*-}mirrorlist r,
  /etc/pacman.d/gnupg/{,**} r,
  /etc/pacman.d/gnupg/trustdb.gpg w,

  /var/lib/aurbuild/@{arch}/@{user}/@{bin}/** Cx -> new-root,
  /var/lib/aurbuild/@{arch}/@{user}/usr/share/libalpm/scripts/** Cx -> new-root,

  /usr/share/devtools/lib/*.sh r,
  /usr/share/makepkg/util.sh r,
  /usr/share/makepkg/util/{,*.sh} r,
  /usr/share/terminfo/** r,

  /var/lib/aurbuild/@{arch}/@{user}.lock wk,
  /var/lib/aurbuild/@{arch}/ r,
  /var/lib/aurbuild/@{arch}/@{user}/ rw,
  /var/lib/aurbuild/@{arch}/@{user}/** rwl -> /var/lib/aurbuild/@{arch}/@{user}/**,

  @{att}@{run}/systemd/resolve/io.systemd.Resolve rw,

  @{tmp}/.tmp@{rand6} r,
  @{tmp}/pacman.conf.@{rand4} rw,
  @{tmp}/sed@{rand6} rw,

  /dev/pts/@{u8} rw,

  profile new-root flags=(attach_disconnected,mediate_deleted) {
    include <abstractions/base>
    include <abstractions/nameservice-strict>

    capability audit_write,
    capability chown,
    capability dac_override,
    capability fowner,
    capability fsetid,
    capability sys_admin,
    capability sys_chroot,

    network netlink raw,

    unix type=stream peer=(label=mkarchroot//pacman),

    ptrace read peer=@{p_systemd},

    /var/lib/aurbuild/@{arch}/@{user}/@{bin}/** ix,

    /var/lib/aurbuild/@{arch}/@{user}/ rw,
    /var/lib/aurbuild/@{arch}/@{user}/** r,
    /var/lib/aurbuild/@{arch}/@{user}/usr/share/info/* w,
    /var/lib/aurbuild/@{arch}/@{user}/etc/** rwlk -> /var/lib/aurbuild/@{arch}/@{user}/etc/**,
    /var/lib/aurbuild/@{arch}/@{user}/var/** w,
    /var/lib/aurbuild/@{arch}/@{user}/@{lib}/** mwl -> /var/lib/aurbuild/@{arch}/@{user}/@{lib}/**,
    /var/lib/aurbuild/@{arch}/@{user}/@{log}/** w,
    /var/lib/aurbuild/@{arch}/@{user}/root/.ssh/ w,
    /var/lib/aurbuild/@{arch}/@{user}/tmp/** w,
    /var/lib/aurbuild/@{arch}/@{user}/dev/tty rw,

    @{att}/dev/pts/@{u8} rw, # file_inherit
    @{att}/var/lib/aurbuild/@{arch}/@{user}.lock w, # file_inherit

    include if exists <local/mkarchroot_new-root>
  }

  profile pacman flags=(attach_disconnected) {
    include <abstractions/base>
    include <abstractions/nameservice-strict>
    include <abstractions/ssl_certs>

    capability chown,
    capability dac_read_search,
    capability fsetid,
    capability setfcap,
    capability sys_chroot,

  #network inet dgram ip=192.168.122.208 port=49528 peer=(ip=138.199.17.163, port=443), # failed af match
  #network inet dgram ip=192.168.122.208 port=59402 peer=(ip=138.199.17.171, port=443), # failed af match
  #network inet stream ip=192.168.122.208 port=38758 peer=(ip=138.199.17.171, port=443), # failed af match
  #network inet stream ip=192.168.122.208 port=52932 peer=(ip=199.232.19.52, port=443), # failed af match
  #network inet stream ip=192.168.122.208 port=52938 peer=(ip=199.232.19.52, port=443), # failed af match
  #network inet stream ip=192.168.122.208 port=52944 peer=(ip=199.232.19.52, port=443), # failed af match
  #network inet stream ip=192.168.122.208 port=52954 peer=(ip=199.232.19.52, port=443), # failed af match
  #network inet6 dgram port=37285, # failed af match
  #network inet6 stream peer=(ip=2a02:6ea0:ce00::8), # failed af match
  #network inet6 stream peer=(ip=2a04:4e42:41::820), # failed af match

    network inet dgram,
    network inet6 dgram,
    network inet stream,
    network inet6 stream,
    network netlink raw,

    unix type=stream peer=(label=mkarchroot//new-root),

    @{bin}/pacman  r,

    @{bin}/gpg     rix,
    @{bin}/gpgconf rix,
    @{bin}/gpgsm   rix,

    /var/lib/aurbuild/@{arch}/@{user}/@{bin}/** Px -> mkarchroot//new-root,
    /var/lib/aurbuild/@{arch}/@{user}/usr/share/libalpm/scripts/** Px -> mkarchroot//new-root,

    /etc/pacman.conf r,
    /etc/pacman.d/{,*-}mirrorlist r,
    /etc/pacman.d/gnupg/{,**} r,
    /etc/pacman.d/gnupg/trustdb.gpg w,

    /var/cache/pacman/pkg/* r,
    /var/lib/aurbuild/@{arch}/@{user}/** rwlk -> /var/lib/aurbuild/@{arch}/@{user}/**,

    @{log}/pacman.log w,

    @{HOME}/ r,

    @{tmp}/pacman.conf.@{rand4} rw,

    @{PROC}/@{pid}/mounts r,

    @{att}@{run}/systemd/resolve/io.systemd.Resolve rw,
    @{att}/dev/pts/@{u8} rw, # file_inherit
    @{att}/var/lib/aurbuild/@{arch}/@{user}.lock w, # file_inherit

    include if exists <local/mkarchroot_pacman>
  }

  #profile sudo flags=(attach_disconnected) {
  profile sudo flags=(attach_disconnected) {
    include <abstractions/base>
    include <abstractions/app/sudo>

    @{bin}/mkarchroot rPx,

    include if exists <local/mkarchroot_pacman>
  }

  include if exists <local/mkarchroot>
}

# vim:syntax=apparmor
