abi <abi/5.0>,

include <tunables/global>

@{chroot_dirs}  = /var/lib/archbuild/{core,extra}-@{arch}/
@{chroot_dirs} += /var/lib/aurbuild/@{arch}/

@{exec_path} = @{bin}/makechrootpkg
profile makechrootpkg @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/cgroup-limits>
  include <abstractions/nameservice-strict>

  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability fsetid,
  capability sys_admin,

  @{exec_path} mr,

  @{sh_path} rix,
  @{coreutils_path} rix,

  @{bin}/arch-nspawn Px,
  @{sbin}/btrfs     rix,
  @{bin}/flock      rix,
  @{bin}/getent     rix,
  @{bin}/gettext    rix,
  @{bin}/mountpoint rix,
  @{bin}/pacman     rix,
  @{bin}/pacman-conf Px,
  @{bin}/pacman-key  Px,
  @{bin}/rsync       Cx -> rsync,
  @{bin}/sudo        Cx -> sudo,
  @{bin}/tput       rix,

  /usr/share/devtools/lib/**.sh r,
  /usr/share/makepkg/util.sh r,
  /usr/share/makepkg/util/{,*.sh} r,
  /usr/share/terminfo/** r,

  /etc/makepkg.conf r,
  /etc/makepkg.conf.d/{,**} r,

  @{chroot_dirs}/ r,
  @{chroot_dirs}/@{user}/{,**} r,
  @{chroot_dirs}/@{user}.lock wk,
  @{chroot_dirs}/@{user}/build/ rw,
  @{chroot_dirs}/@{user}/chrootbuild w,
  @{chroot_dirs}/@{user}/etc/** w,
  @{chroot_dirs}/@{user}/logdest/{,*.log} w,
  @{chroot_dirs}/@{user}/pkgdest/ w,
  @{chroot_dirs}/@{user}/srcdest/ w,
  @{chroot_dirs}/@{user}/srcpkgdest/ w,
  @{chroot_dirs}/@{user}/startdir/ w,

  @{user_pkg_dirs}/{,**} r,
  @{user_pkg_dirs}/**.log w,

  @{tmp}/makechrootpkg.@{rand10}/{,**/} rw,

  @{PROC}/@{pids}/cgroup r,
  @{PROC}/@{pids}/mountinfo r,

  /dev/pts/@{u8} rw,

  profile rsync {
    include <abstractions/base>
    include <abstractions/nameservice-strict>

    capability chown,
    capability dac_override,
    capability dac_read_search,
    capability fowner,
    capability fsetid,

    @{bin}/rsync r,

    @{chroot_dirs}/** rw,

    /dev/pts/@{u8} rw, # file_inherit

    include if exists <local/makechrootpkg_rsync>
  }

  profile sudo flags=(attach_disconnected) {
    include <abstractions/base>
    include <abstractions/app/sudo>

    capability chown,

    @{sh_path}           ix,
    @{bin}/env           ix,
    @{bin}/makechrootpkg Px,
    @{bin}/makepkg       Px,

    @{chroot_dirs}/@{user}.lock w, # file_inherit

    owner @{user_pkg_dirs}/**/PKGBUILD r,

    include if exists <local/makechrootpkg_sudo>
  }

  include if exists <local/makechrootpkg>
}

# vim:syntax=apparmor
