abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/octopi-cachecleaner
profile octopi-cachecleaner @{exec_path} {
  include <abstractions/base>
  include <abstractions/fonts-strict>
  include <abstractions/icons>
  include <abstractions/kde-base>
  include <abstractions/qt>

  network inet stream,
  #network inet stream ip=127.0.0.1 port=12703, # failed af match
  #network inet stream ip=127.0.0.1 port=12703 peer=(ip=127.0.0.1, port=50122), # failed af match

  @{exec_path} mr,

  @{bin}/ps       Px,
  @{bin}/qt-sudo  Px -> octopi//sudo,
  @{bin}/paccache Px,

  /etc/machine-id r,

  owner @{user_config_dirs}/octopi/ rw,
  owner @{user_config_dirs}/octopi/** rwlk -> @{user_config_dirs}/octopi/#@{int},

  owner /tmp/qipc_sharedmemory_orgarntoctopi@{hex} rw,
  owner /tmp/qipc_systemsem_orgarntoctopi@{hex} rw,
  owner /tmp/qtsingleapp-CacheC-8d2f-3e8 w,
  owner /tmp/qtsingleapp-CacheC-8d2f-3e8-lockfile rwk,

  @{PROC}/sys/kernel/random/boot_id r,

  include if exists <local/octopi-cachecleaner>
}

# vim:syntax=apparmor
