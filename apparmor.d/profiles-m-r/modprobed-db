abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/modprobed-db
profile modprobed-db @{exec_path} {
  include <abstractions/base>
  include <abstractions/cgroup-limits>
  include <abstractions/consoles>
  include <abstractions/nameservice-strict>

  capability dac_override,
  capability dac_read_search,

  @{exec_path} mr,

  @{sh_path}           rix,
  @{bin}/cat           rix,
  @{bin}/cp            rix,
  @{bin}/cut           rix,
  @{bin}/{m,g,}awk     rix,
  @{bin}/getent        rix,
  @{bin}/{,e}grep      rix,
  @{bin}/logname       rix,
  @{bin}/md5sum        rix,
  @{bin}/mkdir         rix,
  @{bin}/rm            rix,
  @{bin}/sed           rix,
  @{bin}/sort          rix,
  @{bin}/uniq          rix,
  @{bin}/wc            rix,

  /usr/share/modprobed-db/** r,
  /usr/share/terminfo/** r,

  owner @{user_config_dirs}/modprobed-db/ w,
  owner @{user_config_dirs}/{,modprobed-db/}modprobed-db.conf rw,
  owner @{user_config_dirs}/{,modprobed-db/}modprobed.db rw,

  owner @{user_share_dirs}/modprobed-db/ w,
  owner @{user_share_dirs}/modprobed-db/modprobed.db rw,

  owner @{tmp}/.inmem rw,
  owner @{tmp}/.potential_new_db rw,

        @{PROC}/modules r,
  owner @{PROC}/@{pid}/loginuid r,

  include if exists <local/modprobed-db>
}

# vim:syntax=apparmor
